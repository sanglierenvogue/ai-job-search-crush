# Local, gitignored configuration for .scripts/analyze-vision.py.
# Copy to .env and fill in the values; .env is never committed.
#
# Required: bearer key for your OpenAI-compatible chat-completions
# gateway (the one that serves the vision-capable model).
LLM_API_KEY=
# Optional overrides (defaults: the OpenAI default endpoint and
# qwen3.8-27b; see .scripts/analyze-vision.py).
# LLM_BASE_URL=
# LLM_MODEL=qwen3.8-27b
